{
  "name": "isengard",
  "version": "0.1.0",
  "description": "AWS Account Management SaaS Platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npx eslint . --ext .ts,.tsx",
    "lint:backend": "cd backend && npx eslint . --ext .ts",
    "lint:cfn": "cfn-lint infrastructure/**/*.yaml",
    "lint:cfn-nag": "cfn_nag_scan --input-path infrastructure/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "cd frontend && npx tsc --noEmit",
    "typecheck:backend": "cd backend && npx tsc --noEmit",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "backend/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "infrastructure/**/*.yaml": [
      "cfn-lint"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
